# Copy to .env and fill in. `docker compose --profile app up -d --build` reads it.
# Never commit .env: it holds secrets.

# --- required on a server ---------------------------------------------------
# The address readers open. Links in emails and the Google sign-in come back here.
APP_URL=https://read.example.com
# You. This account is the owner: the only one that may use Claude Code on this server.
OWNER_EMAIL=you@example.com
# Encrypts the readers' API keys. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If you lose it, readers only have to add their keys again.
APP_SECRET=
# Database password. Set it before the first start; changing it later does not change the database.
POSTGRES_PASSWORD=

# --- email (sign-up confirmation, sign-in links, password reset) -------------
# Without SMTP_HOST the links are printed in the app log (docker compose logs app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Reading Companion <no-reply@example.com>

# --- optional ------------------------------------------------------------------
# 0 closes sign-up: only the owner and accounts that already exist can sign in.
ALLOW_REGISTRATION=1
# "Sign in with Google": make an OAuth client (type: web application) at console.cloud.google.com,
# with this redirect URI:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your domain name, for the https profile (Caddy gets the certificate). Point its DNS at this server first.
DOMAIN=read.example.com
# Where the app listens on this machine. Keep 127.0.0.1 behind Caddy or another proxy.
APP_PORT=127.0.0.1:8000
# Book files in S3 or an S3-compatible store, instead of the local volume.
S3_BUCKET=
S3_ENDPOINT_URL=
